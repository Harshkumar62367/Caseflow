# Server-side only. Set this in Vercel Production and Preview environments.
# Use a dedicated role with access only to the caseflow_demo schema.
# Leave unset for the local SQLite recording database.
# CASEFLOW_DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=verify-full

# A random value for the authenticated benchmark reset endpoint.
# BENCHMARK_RESET_KEY=replace-with-a-random-value
